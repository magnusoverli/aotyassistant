# Copy to .env. Docker Compose loads it automatically; Node needs --env-file=.env.
# Docker's published address; use 0.0.0.0 for trusted LAN/Tailscale access.
BIND_IP=127.0.0.1
PORT=3000
# Native Node bind address; the Docker image already listens on 0.0.0.0 internally.
LISTEN_HOST=127.0.0.1
# Initial guest URL hint. Host UI address settings override it durably without editing this file.
# Use a stable LAN hostname or configure "Use the address I opened" in Connections & settings.
GUEST_URL=http://localhost:3000
DATA_DIR=./data
# Fallback without a Music Assistant connection. Music starts only on Play.
PLAYBACK_MODE=demo
DEMO_TRACK_SECONDS=30
# Optional developer CLI probe only. Configure the app's connection in /host/settings.
MUSIC_ASSISTANT_URL=http://music-assistant.local:8095
MUSIC_ASSISTANT_TOKEN=
PLAYBACK_DESTINATION=
