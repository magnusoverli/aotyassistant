{
  "name": "doom-room",
  "version": "2.0.25",
  "description": "Turn-based music sharing for Home Assistant, powered by Music Assistant.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magnusoverli/doom-room.git"
  },
  "bugs": "https://github.com/magnusoverli/doom-room/issues",
  "homepage": "https://github.com/magnusoverli/doom-room#readme",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.server.json && node scripts/build-sendspin.mjs",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "check:release": "node scripts/check-release.mjs",
    "check:build": "node scripts/check-build.ts",
    "bench:validation": "tsx scripts/validation-bench.ts",
    "release": "tsx scripts/release.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "npm run build && playwright test",
    "test:container": "docker build -t doom-room:smoke . && npm run test:container:built",
    "test:container:built": "tsx scripts/container-smoke.ts && tsx scripts/upload-smoke.ts && tsx scripts/tailscale-smoke.ts",
    "ma:probe": "tsx scripts/ma-probe.ts"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@sendspin/sendspin-js": "6.0.0",
    "bonjour-service": "^1.4.4",
    "express": "^5.3.0",
    "ipaddr.js": "^2.5.0",
    "music-metadata": "^12.3.5",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
