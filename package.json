{
  "name": "albums-of-the-year",
  "version": "0.3.11",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "npm run build && playwright test",
    "test:container": "docker build -t aotyassistant:smoke . && tsx scripts/container-smoke.ts && tsx scripts/upload-smoke.ts",
    "ma:probe": "tsx scripts/ma-probe.ts"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "express": "^5.1.0",
    "ipaddr.js": "^2.5.0",
    "music-metadata": "^12.2.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "ws": "^8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
